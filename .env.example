# ============================================================
# NESTA — exemple de configuration d'environnement
# Copiez ce fichier vers `.env.local` et remplissez vos valeurs :
#   cp .env.example .env.local
# Le fichier `.env.local` n'est jamais versionné (voir .gitignore).
# ============================================================

# URL publique de votre projet Supabase.
# Où la trouver : tableau de bord Supabase > Paramètres > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » de votre projet Supabase (utilisée par le navigateur).
# Où la trouver : tableau de bord Supabase > Paramètres > API > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service_role » — SERVEUR UNIQUEMENT, jamais exposée au navigateur.
# Contourne les politiques RLS : à n'utiliser que côté serveur, avec prudence.
# Où la trouver : tableau de bord Supabase > Paramètres > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Stripe — paiements (forfaits vendeur + abonnements Projets).
# Inactif tant que ces variables sont vides : le site affiche
# alors « paiement bientôt disponible » au lieu de planter.
# Où les trouver : dashboard.stripe.com > Developers > API keys
#   - STRIPE_SECRET_KEY : clé secrète (sk_live_... en production,
#     sk_test_... pour tester — jamais de clé en dur dans le code).
#   - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY : clé publique (pk_live_...).
#   - STRIPE_WEBHOOK_SECRET : Developers > Webhooks > ajouter un
#     endpoint https://nesta-drab.vercel.app/api/stripe/webhook
#     (événements : checkout.session.completed,
#     customer.subscription.created/updated/deleted,
#     invoice.payment_failed) puis copier le « Signing secret »
#     (whsec_...).
# Sur Vercel : Project > Settings > Environment Variables.
# ============================================================
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# Courriels transactionnels — Resend (offre gratuite : 3 000/mois).
# Où l'obtenir : resend.com > API Keys (gratuit, sans carte).
# - RESEND_API_KEY : clé d'API (re_...).
# - EMAIL_FROM : expéditeur affiché. TANT QUE le domaine
#   groupenesta.ca n'est pas acheté ET vérifié dans Resend,
#   laisser vide : l'envoi part de « Nesta <onboarding@resend.dev> »
#   (adresse de test Resend). Après vérification du domaine :
#   EMAIL_FROM="Groupe Nesta <bonjour@groupenesta.ca>"
# Sur Vercel : Project > Settings > Environment Variables.
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=
